{% extends "base.html.j2" %}
{% block title %}Tennis trends{% endblock %}
{% block body %}

<header>
  <h1>Trends</h1>
  <div class="sub">
    {{ sessions | length }} session(s)
    {% if since %}since {{ since }}{% endif %}
    {% if sessions %}&middot; {{ sessions[0][0] }} to {{ sessions[-1][0] }}{% endif %}
  </div>
  <nav>
    <a href="#sessions">Sessions</a>
    <a href="#metrics">Metrics over time</a>
  </nav>
</header>

<h2 id="sessions">Sessions</h2>
<table>
  <thead><tr><th>Date</th><th>Session</th><th>Stroke type</th><th>Swings</th></tr></thead>
  <tbody>
    {% for row in rows %}
    <tr>
      <td>{{ row.date }}</td><td>{{ row.session_id }}</td>
      <td>{{ row.stroke_type }}</td><td>{{ row.swings }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<h2 id="metrics">Metrics over time</h2>
{% if figures %}
<p class="sub">Session mean with a &plusmn;1 std band, one line per stroke type.</p>
<div class="grid">
  {% for name, figure in figures %}
  <div>{{ figure | safe }}</div>
  {% endfor %}
</div>
{% else %}
<p class="muted">No metric has values in these sessions yet.</p>
{% endif %}

{% endblock %}
